+
+#ifdef HIOMT
+// HiOM wrapper for the Halo hash_api harness. Mirrors the VIPERT block
+// (client-based API) because HiOM wraps Viper and owns the write-path index.
+// Instantiated as <uint64_t,uint64_t> to match the harness's NONVAR 8B
+// key/value, identical to VIPERT — apples-to-apples with CCEH/Dash/CLevel/Viper
+// here. (The paper's K8/V200 numbers live in the separate ycsb_bm HiOMFixture
+// track, not this harness.) Setup mirrors benchmark/fixtures/hiom_fixture.hpp:
+// Viper(cceh_init_cap=1) + ColdTier + Checkpoint + HiOM.
+#include <cstdlib>
+#include <filesystem>
+#include <memory>
+#include <system_error>
+
+#include "viper/viper.hpp"
+#include "viper/hiom/checkpoint.hpp"
+#include "viper/hiom/cold_tier.hpp"
+#include "viper/hiom/hiom.hpp"
+
+class hash_api {
+ public:
+  using ViperT = viper::Viper<uint64_t, uint64_t>;
+  using HiomT = viper::hiom::HiOM<uint64_t, uint64_t>;
+  using Client = HiomT::Client;
+
+  std::unique_ptr<ViperT> viper_;
+  std::unique_ptr<viper::hiom::ColdTier> cold_;
+  std::unique_ptr<viper::hiom::Checkpoint> chkpt_;
+  std::unique_ptr<HiomT> hiom_;
+
+  hash_api(size_t sz = (1ULL << 21)) {
+    // HotTier capacity in buckets (×16 slots). Override via
+    // HIOM_HOT_BUCKETS_LOG2 for the C2 capacity sweep (validated [10,30],
+    // same contract as HiOMFixture).
+    std::size_t hot_buckets = sz;
+    if (const char *e = std::getenv("HIOM_HOT_BUCKETS_LOG2")) {
+      char *end = nullptr;
+      const unsigned long l = std::strtoul(e, &end, 10);
+      if (end != e && *end == '\0' && l >= 10 && l <= 30)
+        hot_buckets = 1ULL << l;
+    }
+
+    const std::string root = index_pool_name;  // "/pmem0/hiom_eval/"
+    const std::string pooldir = root + "HIOM_viper";
+    const std::string coldf = root + "HIOM_cold.bin";
+    const std::string chkptf = root + "HIOM_chkpt.bin";
+
+    // Prefix-guarded cleanup of our OWN artefacts only (CLAUDE.md /pmem0 rule:
+    // remove_all under a checked prefix from code, never a blanket shell rm).
+    if (root.rfind("/pmem0/hiom_eval", 0) == 0) {
+      std::error_code ec;
+      std::filesystem::remove_all(pooldir, ec);
+      std::filesystem::remove(coldf, ec);
+      std::filesystem::remove(chkptf, ec);
+    }
+    std::filesystem::create_directories(root);
+
+    viper::ViperConfig vcfg;
+    vcfg.cceh_init_cap = 1;  // HiOM owns the index; shrink CCEH ~2GB -> 16KB.
+    viper_ = ViperT::create(pooldir, pool_size, vcfg);
+    cold_ = viper::hiom::ColdTier::create(coldf);
+    chkpt_ = viper::hiom::Checkpoint::create(chkptf);
+
+    HiomT::FlusherConfig fcfg;
+    HiomT::CheckpointConfig ccfg;
+    ccfg.cadence_entries = 4096;
+    HiomT::RecoveryConfig rcfg;  // tail_scan=false (fresh DB)
+    hiom_ = std::make_unique<HiomT>(*viper_, hot_buckets, cold_.get(), fcfg,
+                                    chkpt_.get(), ccfg, rcfg);
+  }
+  ~hash_api() {
+    // Order: HiOM dtor drains commit buffer + joins flusher (reads viper_),
+    // then drop checkpoint/cold/viper.
+    hiom_.reset();
+    chkpt_.reset();
+    cold_.reset();
+    viper_.reset();
+  }
+
+  std::string hash_name() { return "HiOM"; }
+  Client get_client() { return hiom_->get_client(); }
+
+  bool insert(size_t key, size_t /*value_len*/, char * /*value*/, Client &c) {
+    c.put(key, key);
+    return true;
+  }
+  bool update(size_t key, size_t /*value_len*/, char * /*value*/, Client &c) {
+    c.update(key, [key](uint64_t *v) {
+      *v = key + 1;
+      viper::internal::pmem_persist(v, sizeof(uint64_t));
+    });
+    return true;
+  }
+  bool find(size_t key, Client &c, uint64_t *v) { return c.get(key, v); }
+  bool erase(size_t key, Client &c) {
+    c.remove(key);
+    return true;
+  }
+  void load_factor(Client &) {}
+  // Drains the commit buffer + joins the flusher so a subsequent read phase
+  // doesn't contend with PMem write traffic. Single-threaded callers only.
+  void flush() {
+    if (hiom_) hiom_->flush_and_wait();
+  }
+  void wait() {}
+};
+#endif
